# Copy to `.env` and fill in real values for local development.
# Do NOT commit `.env` (gitignored).

# --- Database ---
DATABASE_URL=sqlite:///./data/sbc.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- CORS (JSON array — required format for pydantic-settings List fields) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8448","http://127.0.0.1:8448"]

# --- SMTP (verification codes). Leave blank/dummy for local UI work. ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# --- Dev-only auth bypass (CSV). EMPTY in staging/production. ---
# Example local value: demo@example.com
DEV_BYPASS_EMAILS=

# --- Token / code TTLs ---
VERIFICATION_CODE_TTL_MINUTES=10
AUTH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_RETENTION_DAYS=7
INVITE_TTL_DAYS=30
SESSION_ACTIVITY_TTL_DAYS=7
SEND_CODE_RATE_LIMIT_PER_HOUR=5

# --- Cookies (true behind HTTPS) ---
COOKIE_SECURE=false
SESSION_COOKIE_NAME=sbc_session

# --- Optional AI parse ---
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-Text-01

# --- App ---
APP_ENV=dev
DEBUG=true

# Skip demo seed on uvicorn startup (recommended true).
SBC_SKIP_SEED=true
# Optional: owner email for seeded ledgers (default demo@example.com).
# SEED_USER_EMAIL=demo@example.com
