# Copy this file to `.env` and fill in real values for local development.
# Do NOT commit `.env` (it's gitignored).

# --- Database ---
DATABASE_URL=sqlite:///./data/sbc.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- CORS (JSON array, pydantic-settings 2.x requires this format for List fields) ---
# ⚠️ MUST be JSON array — comma-separated string breaks pydantic-settings 2.x dotenv loading.
# See antipattern #31 in SPEC.md.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8448","http://127.0.0.1:8448"]

# --- SMTP (verification codes) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jessejia1001@gmail.com
SMTP_PASSWORD=<from-bw>          # App Password from Bitwarden; rotate, never commit
SMTP_FROM=jessejia1001@gmail.com
SMTP_USE_TLS=true

# --- Token / code TTLs ---
VERIFICATION_CODE_TTL_MINUTES=10
AUTH_TOKEN_TTL_DAYS=30

# --- AI parse (T11) ---
# MiniMax API key. Leave blank in dev: /bills/parse will then return
# 422 ai_unavailable and the frontend falls back to a manual form.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-Text-01

# --- App ---
APP_ENV=dev
DEBUG=true

# --- Session invite TTL (T09) ---
# Default lifetime for a session invite link. v0.1 default: 30 days.
INVITE_TTL_DAYS=30

# --- v0.3.13 dev seed opt-out + cleanup (反 #136, SPEC §3.13) ---
# Default: skip seed_dev_data at uvicorn startup.
# - SBC_SKIP_SEED=true  (default) → no xinhua1001 user / no 泰国测试账单 / no 个人测试 fixtures auto-injected.
# - SBC_SKIP_SEED=false            → opt back in (use for a sprint walk / demo).
# - ENV=production                 → ALWAYS skipped, regardless of SBC_SKIP_SEED.
#
# Reason: every uvicorn restart was re-injecting ~30 rows into the dev's
# own SBC personal space; cleaning manually was a recurring chore. Now
# skipped by default so restarts are quiet.
SBC_SKIP_SEED=true

# TTL windows for `python -m scripts.cleanup_expired`:
#   auth_token_ttl_days=30           → drop auth_tokens whose expires_at<now
#                                      OR (created_at<now-30d AND last_used_at IS NULL).
#   verification_code_retention_days=7 → drop verification_codes whose
#                                      used=1 AND created_at<now-7d, plus
#                                      used=0 AND expires_at<now-1h.
# Tune per environment if you need to keep audit trails longer.
AUTH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_RETENTION_DAYS=7

