# split-bill-calculator prod env (cp 到 .env 后填实际值)
# 反 #119: dev/prod 配置分离, 真值放 .env (gitignored)

# BE uvicorn
SBC_ENV=production
SBC_SKIP_SEED=false
SBC_SKIP_TEST_TRUNCATE=1

# 数据库 (SQLite path 默认 data/sbc.db, 无需 override)
# DATABASE_URL=sqlite:///./data/sbc.db

# Auth (dev 任意 6 位数字; prod 待定 - SMTP? 维持 dev?)
SBC_AUTH_DEV_BYPASS=true
# SBC_SMTP_HOST=smtp.example.com
# SBC_SMTP_PORT=587
# SBC_SMTP_USER=...
# SBC_SMTP_PASS=...

# Cloudflared (docker-compose 引用)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# 域名 (split.jesdigi.com)
SBC_PUBLIC_URL=https://split.jesdigi.com
